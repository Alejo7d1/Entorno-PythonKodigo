# Plantilla de variables de entorno de la app de Taxis NYC.
#
# Copiar como `.env` junto a `app/comun.py` (queda ignorado por git) y ajustar el valor.
# `comun.py` lee, en este orden:
#   1. `st.secrets["API_URL"]`  (Streamlit Cloud → Advanced settings → Secrets)
#   2. la variable de entorno `API_URL` (aquí, vía `.env`)
#   3. `http://localhost:8000` (valor por defecto para desarrollo)
#
# En Streamlit Community Cloud los Secrets se escriben en formato TOML, sin `export`:
#   API_URL = "https://<tu-api>.onrender.com"
#
# En local también sirve sin crear `.env`:
#   PowerShell:  $env:API_URL = "http://localhost:8000"
#   bash:        export API_URL="http://localhost:8000"

API_URL=http://localhost:8000
